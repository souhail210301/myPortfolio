			"label": "Open preview URL",
			"type": "shell",
			"command": "powershell -NoProfile -Command \"Write-Output 'Waiting for Vite to report the dev server URL...'; $pattern='Local:\\s+(http://\\S+)'; Get-Content -Path .\\node_modules\\.vite\\deopt.log -Wait -ErrorAction SilentlyContinue | Out-Null\"",
			"isBackground": false
		},
